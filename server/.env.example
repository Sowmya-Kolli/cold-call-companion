# Cold Call Companion — Server Environment Variables
# Copy this file to .env and fill in your actual values.
# Never commit .env to source control.

# ── Server ────────────────────────────────────────────────────
PORT=3001

# ── Supabase ──────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
# URL looks like: https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Use the service_role key (secret) — NOT the anon/public key.
# This bypasses Row Level Security and must stay server-side only.
SUPABASE_SECRET_KEY=your-service-role-secret-key-here

# ── Gemini AI ─────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Model to use for call summaries. Change to upgrade without code edits.
# Officially verified Google Gemini models: gemini-3.5-flash (recommended), gemini-3.8-flash, gemini-flash-latest
GEMINI_MODEL=gemini-3.5-flash

# ── CORS ──────────────────────────────────────────────────────
# The URL(s) of your frontend (comma-separated if multiple, no trailing slashes)
# Example for local + Vercel: http://localhost:5173,https://cold-call-companion.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# ── Node ──────────────────────────────────────────────────────
NODE_ENV=development
